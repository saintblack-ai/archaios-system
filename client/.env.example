# Production frontend builds must set this to the public Cloudflare Worker.
VITE_API_BASE_URL=
# Legacy compatibility only. Prefer VITE_API_BASE_URL.
VITE_BACKEND_URL=
VITE_ADMIN_EMAIL=

# Public business/legal placeholders shown in launch-readiness UI.
VITE_PUBLIC_BUSINESS_LEGAL_NAME=
VITE_PUBLIC_EIN_STATUS=pending
VITE_PUBLIC_PRIVACY_POLICY_URL=
VITE_PUBLIC_TERMS_URL=
VITE_PUBLIC_REFUND_POLICY_URL=
VITE_PUBLIC_CONTACT_EMAIL=

VITE_ALPHA_VANTAGE_API_KEY=
VITE_NEWS_API_KEY=
VITE_ACLED_API_URL=
VITE_ACLED_API_KEY=
VITE_ACLED_EMAIL=
# Supabase client auth keys for local sign-in and gated features
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ALERT_WEBHOOK_URL=
VITE_ALERT_WEBHOOK_TOKEN=
# Optional for Stripe.js client-side integrations (checkout redirect currently uses backend session URL)
VITE_STRIPE_PUBLISHABLE_KEY=
# Optional public price ID hints for the pricing readiness panel
VITE_STRIPE_PRO_PRICE_ID=
VITE_STRIPE_ELITE_PRICE_ID=

# Server-only Stripe/Supabase secrets must stay out of Vite env files.
# Configure them with Wrangler secrets for the Worker runtime instead.
# Required Worker secrets: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, STRIPE_SECRET_KEY,
# STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_PRO, STRIPE_PRICE_ELITE.
